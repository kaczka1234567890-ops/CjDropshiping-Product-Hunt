{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/index.js" },
    { "src": "/admin", "dest": "/web/admin.html" },
    { "src": "/admin/", "dest": "/web/admin.html" },
    { "src": "/(.*)", "dest": "/web/$1" }
  ]
}
