# Copy this file to .env and enter your own token locally.
# Never commit .env or paste the key into source code.
#
# CJ_ACCESS_TOKEN: paste your CJ API Key (format: CJxxxxxxx@api@...).
# The server automatically exchanges it for an access token and caches it
# in .cj-token-cache.json (gitignored). You can also paste an already
# obtained access token directly.
CJ_ACCESS_TOKEN=YOUR_CJ_API_KEY_HERE
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
# Confirmed against CJ API 2.0 docs:
CJ_PRODUCT_LIST_PATH=/product/listV2
CJ_PRODUCT_DETAIL_PATH=/product/query
PORT=3000
