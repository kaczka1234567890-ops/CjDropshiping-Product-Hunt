# CJ Product Hunter — Cloud Version
# Copy to .env and fill in your own values. NEVER commit the real .env.
# ── Supabase (required) ──────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
# ── Encryption (required — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your-32-byte-hex-key-here
# ── Admin (optional — set to comma-separated user UUIDs)
ADMIN_USER_IDS=
# ── CJ API ───────────────────────────────────────────────
CJ_ACCESS_TOKEN=YOUR_CJ_API_KEY_HERE
CJ_API_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_PRODUCT_LIST_PATH=/product/listV2
CJ_PRODUCT_DETAIL_PATH=/product/query
PORT=3000
