{
  "manifest_version": 3,
  "name": "CJ Product Hunter",
  "version": "1.0.0",
  "description": "Hunt CJ winning products: search, score, sales, reviews, supplier info, ship quotes. Runs on your own local backend.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CJ Product Hunter — click to open panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://localhost:3000/*"]
}
