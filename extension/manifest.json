{
  "manifest_version": 3,
  "name": "CJ Product Hunter",
  "version": "1.0.8",
  "description": "Hunt CJdropshipping winning products: search, score, sales, reviews, supplier info and one-click listing.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CJ Product Hunter — click to open panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "minimum_chrome_version": "116",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": [
    "https://cj-winning-product-hunter-poc.vercel.app/*",
    "*://*.qksource.com/*",
    "*://*.cjdropshipping.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://cj-winning-product-hunter-poc.vercel.app https://cjdropshipping.com"
  },
  "web_accessible_resources": [{
    "resources": ["icons/*.png"],
    "matches": ["<all_urls>"]
  }]
}
